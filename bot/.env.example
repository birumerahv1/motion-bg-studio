# --- Required ---
# Telegram bot token from @BotFather
BOT_TOKEN=123456789:AABBccddEEffGGhhIIjjKKllMMnnOOppQQ

# --- Operator (SaaS) configuration ---
# Comma-separated Freepik API keys used for ALL paid users (auto-failover).
# These are YOUR keys; users do not provide their own keys in the SaaS model.
# You can also add keys at runtime via /opaddkey from Telegram.
# OPERATOR_FREEPIK_KEYS=FPSXabc...,FPSXdef...

# Comma-separated Telegram user IDs that get admin powers on startup.
# Get yours from @userinfobot. After bootstrap you can add more via /setadmin.
# ADMIN_USER_IDS=123456789,987654321

# Set to "1" to ALSO allow users to /addkey their own Freepik keys (BYO mode).
# Default 0: pure SaaS mode where only operator keys are used.
# ALLOW_BYO_KEYS=0

# --- Optional plumbing ---
# Where the SQLite DB lives. Default is ok for local; in Docker the image
# overrides this to /app/data/bot.db so you can mount a volume there.
# DB_PATH=bot/data/bot.db

# Freepik API base — only override for testing.
# FREEPIK_BASE=https://api.freepik.com

# How often to poll Freepik for task status (seconds).
# POLL_INTERVAL=4

# Caps for files uploaded by users (bytes).
# MAX_IMAGE_BYTES=10485760
# MAX_VIDEO_BYTES=15728640

# Logging level (DEBUG, INFO, WARNING, ERROR).
# LOG_LEVEL=INFO
